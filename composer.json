{
  "name": "wexample/symfony-activity",
  "description": "What happens to a subject — a user, an organization — kept as a history, recorded by category, each category enabled, kept and purged as the application decides",
  "version": "3.0.3",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyActivity\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyActivity\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/security-core": "^7.4 || ^8.0",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-security": ">=4.0.0",
    "symfony/doctrine-bridge": "^7.4 || ^8.0",
    "symfony/uid": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "damienharper/auditor-bundle": "^6.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0",
    "symfony/browser-kit": "^7.4 || ^8.0",
    "symfony/security-bundle": "^7.4 || ^8.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}